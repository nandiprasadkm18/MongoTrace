{
  "name": "mongotrace",
  "version": "1.0.0",
  "description": "MongoTrace — Self-Evolving Digital Evidence Intelligence Platform",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node server.js",
    "seed": "node check_db.js",
