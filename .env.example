PORT=5050
MONGODB_URI=mongodb://127.0.0.1:27017/mongotrace
NODE_ENV=development
FRONTEND_URL=http://localhost:5050
# Comma-separated allowlist used by browser clients. Do not use * in production.
CORS_ORIGIN=http://localhost:5050
# The server never seeds automatically. Enable only with a disposable demo database.
SEED_DEMO_DATA=false
# Required, together with X-MongoTrace-Confirm: DELETE_DEMO_DATA, for clear/reseed routes.
ENABLE_DESTRUCTIVE_ADMIN=false
# Bounded JSON request payload size for text ingestion.
JSON_BODY_LIMIT=10mb

# Production / Render example
# PORT=8080
# MONGODB_URI=mongodb+srv://<user>:<password>@cluster.mongodb.net/mongotrace
# NODE_ENV=production
# FRONTEND_URL=https://your-app.onrender.com
